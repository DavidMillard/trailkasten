# macOS
.DS_Store
**/.DS_Store

# Obsidian workspace state (per-device, churns constantly)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Community plugin code — installed by each user through Obsidian, never
# vendored here. Only the enabled-plugin list and appearance settings ship.
.obsidian/plugins/
.obsidian/themes/

# Smart Connections embedding cache. Large, machine-local, and regenerated by
# the plugin on first index.
.smart-env/

# Machine-local Claude Code settings
.claude/settings.local.json

# MCP server config: holds API keys and absolute paths.
# Copy .mcp.json.example to .mcp.json and fill it in.
.mcp.json

# Leftover agent worktrees
.claude/worktrees/

# Source PDFs dropped into the fleeting inbox are never note content, and are
# the most likely place for material about other people to arrive. Untracked as
# a rule rather than case by case, so the NEXT one is protected without anyone
# having to remember. Files stay on disk and in Obsidian.
80-Fleeting/**/*.pdf

# Personal scrub patterns, one extended-regex per line. Gitignored.
tools/scrub-patterns.local
